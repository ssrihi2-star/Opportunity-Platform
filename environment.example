# ---------------------------------------------------------------- application
APP_NAME="Opportunity Intelligence System"
ENV=dev                       # dev | test | prod
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------- security
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false           # MUST be true in production
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------------- database
POSTGRES_USER=ois
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=ois
DATABASE_URL=postgresql+asyncpg://ois:change-me-please@postgres:5432/ois
REDIS_URL=redis://redis:6379/0
DB_ECHO=false

# ------------------------------------------------------------ bootstrap admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                # at least 10 characters
SEED_DEMO_DATA=true

# ------------------------------------------------------------------ ingestion
SOURCE_RUN_STALE_MINUTES=60
MAX_RECORDS_PER_RUN=5000
HTTP_TIMEOUT_SECONDS=30
HTTP_CACHE_TTL_SECONDS=900
ROBOTS_CACHE_TTL_SECONDS=86400
# Several sources (SEC EDGAR in particular) require a descriptive User-Agent and
# a contact address. Put a real address here before enabling those sources.
USER_AGENT="OpportunityIntelligenceSystem/0.2 (research; +https://example.invalid/ois)"
CONTACT_EMAIL=ois-operator@example.invalid

# ------------------------------------------------- opportunity gate + scoring
MIN_SIGNAL_TYPES=3
MIN_INDEPENDENT_SOURCES=2
MIN_CONFIDENCE=0.50
MAX_EVIDENCE_AGE_DAYS=30
MIN_RAW_SCORE=30

# ------------------------------------------------------------------------- AI
AI_PROVIDER=echo               # echo | openai | anthropic | gemini | local
AI_MODEL_SMALL=small
AI_MODEL_LARGE=large
AI_DAILY_BUDGET_USD=2.0
AI_MONTHLY_BUDGET_USD=40.0
AI_SHORTLIST_SIZE=20
MIN_CITATION_DENSITY=0.9
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# -------------------------------------------------------------- notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --------------------------------------------------------------- scheduling
# Periodic alert dispatch and digest generation, OFF by default. With this
# false, Celery beat schedules nightly collection and the stale-run janitor
# exactly as before, and alerts are dispatched only when an administrator runs
# POST /api/v1/monitoring/run. Nothing in the API or the test suite starts a
# scheduler; beat is its own process (`docker compose up -d beat`).
# Turning it on REPLACES the bare collection entry with one ordered run —
# collect -> check conditions and dispatch alerts -> write digests — so a
# dependent phase never runs on top of a prerequisite that failed, and
# collection is never scheduled twice. See docs/scheduling.md.
SCHEDULER_ENABLED=false
# IANA timezone the crontabs fire in. Stored timestamps stay UTC either way.
SCHEDULE_TIMEZONE=UTC
# Local hour and minute of the nightly run.
COLLECT_HOUR=3
COLLECT_MINUTE=0
# Stale-run janitor cadence, in minutes.
REAP_EVERY_MINUTES=15
# How far back a scheduled monitoring run looks for change events. Keep it at
# least as wide as the gap between two runs, so a run that failed or was killed
# is picked up by the next one. Events already delivered are suppressed by the
# unique constraint on (user_id, dedupe_key) — but this is a second chance, not a
# queue: delivery is best-effort, and docs/scheduling.md says exactly what can
# still be lost or repeated.
MONITOR_LOOKBACK_HOURS=26
# How many of the most recent events inside that window one run considers.
MONITOR_EVENT_LIMIT=500
# Day name (monday..sunday) in SCHEDULE_TIMEZONE on which the nightly run also
# writes weekly digests. A name, not a number: cron counts days from Sunday and
# Python counts them from Monday. A digest always covers the most recently
# COMPLETED canonical period — the local calendar day before the run, or the ISO
# week (Monday 00:00 to Monday 00:00 local) that closed before it — so monday
# means "the week that closed a few hours ago", while sunday means the week that
# closed six days earlier. Either way it is exactly one weekly digest per week;
# the day only changes how fresh that week is.
DIGEST_WEEKLY_DAY=monday

# -------------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
